# and their checksums, which is a supply-chain control, not a local artefact.
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
tfplan
tfplan.json
.terraform.tfstate.lock.info

# Azure
.azure/

