# Copy to .env for local runs. Never commit .env.
# In Azure these values come from Key Vault via managed identity, not a file.

BOT_ENVIRONMENT=local
BOT_LOG_LEVEL=INFO

# simulated needs no credentials and no network. ccxt_sandbox targets an
# exchange testnet. There is no third option, by design.
BOT_EXCHANGE_BACKEND=simulated
BOT_EXCHANGE_ID=binance
BOT_SANDBOX=true

BOT_SYMBOL=BTC/USDT
BOT_TIMEFRAME=15m
BOT_CANDLE_LIMIT=200

BOT_SMA_FAST=12
BOT_SMA_SLOW=48

BOT_INITIAL_CASH_QUOTE=10000
BOT_MAX_POSITION_QUOTE=1000
BOT_MAX_DAILY_LOSS_QUOTE=100
BOT_MIN_ORDER_NOTIONAL_QUOTE=10
BOT_KILL_SWITCH=false

BOT_FEE_BPS=10
BOT_SLIPPAGE_BPS=5

BOT_SIMULATOR_SEED=1
BOT_SIMULATOR_START_PRICE=30000
BOT_SIMULATOR_VOLATILITY_BPS=40

# Host port 5433: 5432 and the 55392-55491 range are taken on the dev machine.
BOT_DATABASE_URL=postgresql+psycopg://trading:trading@localhost:5433/trading

# Testnet credentials only, withdrawal permission disabled. Required only when
# BOT_EXCHANGE_BACKEND=ccxt_sandbox.
# BOT_EXCHANGE_API_KEY=
# BOT_EXCHANGE_API_SECRET=
