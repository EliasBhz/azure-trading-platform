# Copy to .env for local runs. Never commit .env.
# In Azure these values come from Key Vault via managed identity, not from a file.

BOT_EXCHANGE_BACKEND=simulated
BOT_EXCHANGE_ID=binance
BOT_SANDBOX=true
BOT_SYMBOL=BTC/USDT

BOT_MAX_POSITION_QUOTE=1000
BOT_MAX_DAILY_LOSS_QUOTE=100
BOT_KILL_SWITCH=false

# Testnet credentials only, withdrawal permission disabled.
# BOT_EXCHANGE_API_KEY=
# BOT_EXCHANGE_API_SECRET=

POSTGRES_USER=trading
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=trading
